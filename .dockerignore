# .dockerignore - files excluded from the Docker build context

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
env/
.venv/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Version control
.git/
.gitignore
.gitattributes

# Generated / runtime files
*.log
logs/
*.db
*.sqlite
*.sqlite3
certs/
data/

# Documentation
*.md
docs/

# CI
.github/

# Misc
.DS_Store
Thumbs.db
